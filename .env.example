# ─── Mint · image-generation provider ────────────────────────────────────────
# Everything below is OPTIONAL. With no .env at all the site already generates
# real images through Pollinations' anonymous tier (no key, no signup).

# pollinations | cloudflare | huggingface
MINT_IMAGE_PROVIDER=pollinations

# ── Pollinations — https://pollinations.ai  (recommended)
# Free forever. A token is only needed to remove the watermark and lift the
# ~1-request-per-15s anonymous rate limit. Get one at https://auth.pollinations.ai
POLLINATIONS_TOKEN=

# ── Cloudflare Workers AI — https://dash.cloudflare.com  (fallback)
# Free account, no credit card. 10,000 Neurons/day (~20-30 images).
# Dashboard → AI → Workers AI, then My Profile → API Tokens.
CF_ACCOUNT_ID=
CF_API_TOKEN=

# ── Hugging Face — https://huggingface.co/settings/tokens  (last resort)
# The free tier is now only $0.10 of credit per month.
HF_TOKEN=

# Persian prompts are machine-translated to English before generation,
# because FLUX/SDXL are trained on English captions. Set to `off` to disable.
MINT_AI_TRANSLATE=on
MINT_AI_TIMEOUT=90000

# --- your own endpoint (see tools/worker.js for a ready Cloudflare Worker) ---
# Takes POST {prompt, width, height, seed} with a bearer token, answers image bytes.
MINT_WORKER_URL=
MINT_WORKER_KEY=

# Set to 0 to keep whatever size the provider returns instead of centre-cropping
# the pixels to the target device shape.
MINT_AI_RESHAPE=1

# --- Persian prompt translation via any OpenAI-compatible chat endpoint ---
# Optional. Without a key Mint falls back to MyMemory, then an offline glossary.
MINT_LLM_BASE=https://codecraftapi.com/v1
MINT_LLM_KEY=
MINT_LLM_MODEL=gemini-3.7-flash
