<%- include('../partials/head') %>
<div class="shell">
  <%- include('../partials/sidebar') %>
  <main>
    <div class="phead"><h1><%= t('lb.title') %></h1><p><%= t('lb.lede') %></p></div>
    <div class="tabs" style="margin-bottom:20px"><a class="on"><%= t('lb.week') %></a><a><%= t('lb.month') %></a><a><%= t('lb.all') %></a></div>
    <div class="card" style="overflow:hidden">
      <table class="table">
        <thead><tr><th style="width:62px">#</th><th><%= t('lb.creator') %></th><th><%= t('lb.designs') %></th>
          <th style="text-align:<%= rtl?'left':'right' %>"><%= t('lb.xp') %></th></tr></thead>
        <tbody>
        <% rows.forEach(r => { %>
          <tr style="<%= r.me ? 'background:rgba(109,74,255,.12)':'' %>">
            <td>
              <% if (r.rank<=3) { %>
                <span style="display:inline-grid;place-items:center;width:26px;height:26px;border-radius:50%;font-size:12px;font-weight:750;
                  background:<%= ['linear-gradient(145deg,#FBBF24,#D97706)','linear-gradient(145deg,#D1D5DB,#9CA3AF)','linear-gradient(145deg,#D97706,#92400E)'][r.rank-1] %>;color:#1B1340"><%= num(r.rank) %></span>
              <% } else { %><span class="muted"><%= num(r.rank) %></span><% } %>
            </td>
            <td>
              <div class="row gap12">
                <span class="avatar fs11" style="width:30px;height:30px"><%= r.name.slice(0,2).toUpperCase() %></span>
                <span style="font-weight:<%= r.me?'700':'550' %>" class="ltr"><%= r.name %></span>
                <% if (r.me) { %><span style="font-size:12px"><%= t('lb.you') %></span><% } %>
                <span class="fs11" style="color:<%= r.trend==='up'?'var(--ok)':r.trend==='down'?'var(--danger)':'var(--muted-2)' %>">
                  <%= r.trend==='up'?'▲':r.trend==='down'?'▼':'—' %></span>
              </div>
            </td>
            <td class="muted"><%= num(r.designs) %></td>
            <td style="text-align:<%= rtl?'left':'right' %>;font-weight:700"><%= num(r.xp) %></td>
          </tr>
        <% }) %>
        </tbody>
      </table>
    </div>
  </main>
</div>
<%- include('../partials/foot') %>
<%- include('../partials/tail') %>
