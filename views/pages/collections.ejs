<%- include('../partials/head') %>
<div class="shell">
  <%- include('../partials/sidebar') %>
  <main>
    <div class="phead between" style="flex-wrap:wrap;gap:12px">
      <div><h1><%= t('co.title') %></h1><p><%= t('co.lede') %></p></div>
      <button class="btn btn-primary js-toast" data-msg="<%= t('co.created') %>"><%- icon('plus') %> <%= t('co.new') %></button>
    </div>
    <div class="grid g3">
      <% collections.forEach(c => { %>
        <div class="card rv" style="overflow:hidden;cursor:pointer">
          <div class="coll-mosaic">
            <img src="/img/<%= c.cover[0] %>.webp" alt="" style="width:100%;height:100%;object-fit:cover">
            <div style="display:grid;grid-template-rows:1fr 1fr;gap:2px">
              <img src="/img/<%= c.cover[1] %>.webp" alt="" style="width:100%;height:100%;object-fit:cover">
              <img src="/img/<%= c.cover[2] %>.webp" alt="" style="width:100%;height:100%;object-fit:cover">
            </div>
          </div>
          <div class="pad between"><div><b style="font-size:14px"><%= L(c,'name') %></b>
            <p class="muted" style="font-size:12px"><%= num(c.count) %> <%= t('co.designs') %></p></div>
            <span class="iconbtn"><%- icon('chev') %></span></div>
        </div>
      <% }) %>
    </div>
  </main>
</div>
<%- include('../partials/foot') %>
<%- include('../partials/tail') %>
